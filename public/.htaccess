Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # API -> TWill backend (Node, bound to localhost on this VPS).
  RewriteRule ^api/(.*)$ http://127.0.0.1:38411/api/$1 [P,L]

  # Client-side routes (e.g. /archives) are served by the SPA.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^archives/?$ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Vite emits content-hashed filenames under /assets, so they never change.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json
</IfModule>

# Never expose VCS metadata or dotfiles that may sit in the web root.
RedirectMatch 404 /\.(git|env|svn)(/|$)
