Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # API -> TWill backend (Node, bound to localhost on this VPS).
  RewriteRule ^api/(.*)$ http://127.0.0.1:38411/api/$1 [P,L]

  # Client-side routes (e.g. /archives) are served by the SPA.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^archives/?$ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Vite emits content-hashed filenames under /assets, so they never change.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # The private archive must never be indexed, cached by intermediaries,
  # or leak its media links through the Referer header.
  # THE_REQUEST (the original request line) survives the internal rewrite
  # of /archives to index.html, unlike REQUEST_URI.
  <If "%{THE_REQUEST} =~ m#^\S+ /(archives|api)([/?\s]|$)#">
    Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
    Header always set Referrer-Policy "no-referrer"
  </If>

  # The host's default mod_expires adds max-age=172800/Expires to JSON;
  # API data must never be cached, or browsers show stale archives.
  <If "%{THE_REQUEST} =~ m#^\S+ /api/#">
    Header always unset Expires
    Header unset Expires
    Header always set Cache-Control "private, no-store"
    Header set Cache-Control "private, no-store"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json
</IfModule>

# Never expose VCS metadata or dotfiles that may sit in the web root.
RedirectMatch 404 /\.(git|env|svn)(/|$)
